# Copiez ce fichier vers .env, puis choisissez des valeurs privées locales.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=smartcare
POSTGRES_PASSWORD=
POSTGRES_DB=smartcare
# DATABASE_URL peut remplacer ces paramètres pour le client Python uniquement.

# Premier compte uniquement, via la commande explicite start-demo.
# Remplacer la valeur vide dans votre .env privé par 12 à 128 caractères.
# Un compte existant n'est JAMAIS réinitialisé. Aucun secret de démo n'est fourni.
SMARTCARE_DEMO_ADMIN_PASSWORD=
